# ---- Database ----
# Local dev (default): a SQLite file next to the backend
DATABASE_URL=sqlite:///./hackathons.db
# Production: any hosted Postgres (Neon, Supabase, Render, Railway ...)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- Security ----
# Random string. The Next.js server sends it in the X-API-Key header.
# Put the SAME value in the Next.js env as BACKEND_API_KEY.
BACKEND_API_KEY=change-me
# Comma-separated origins allowed to call the API from a browser (optional)
CORS_ORIGINS=http://localhost:3000,https://myhackathons.vercel.app

# ---- AI screenshot extraction ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Email alerts ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=vritika110@gmail.com
# Gmail needs an *App Password* (Google Account > Security > 2-Step Verification > App passwords)
SMTP_PASS=
ALERT_EMAIL=vritika110@gmail.com
ALERT_DAYS=3
ALERT_TIMEZONE=Asia/Kolkata
DASHBOARD_URL=https://myhackathons.vercel.app
