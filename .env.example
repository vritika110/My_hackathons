# Copy this file to .env.local and fill in your values

NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

AUTHORIZED_EMAIL=vritika110@gmail.com

GEMINI_API_KEY=your-gemini-api-key

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=vritika110@gmail.com
SMTP_PASS=your-gmail-app-password
ALERT_EMAIL=vritika110@gmail.com

CRON_SECRET=generate-a-secure-random-string

# Set to "true" to skip OAuth/email for local testing
DEMO_MODE=true

# ---- Python backend (see backend/README.md) ----
BACKEND_URL=http://127.0.0.1:8000
# Must equal BACKEND_API_KEY in backend/.env
BACKEND_API_KEY=change-me
# Vercel sends this automatically as "Authorization: Bearer <CRON_SECRET>" to /api/alerts
# (SMTP / Gemini / ALERT_EMAIL settings now live in backend/.env, not here)
